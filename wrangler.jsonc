{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flickmadness",
	"compatibility_date": "2026-07-07",
	"compatibility_flags": ["nodejs_compat"],
	// Custom domains: Cloudflare provisions the DNS records and certs for
	// these on deploy — never add A/CNAME records for them by hand.
	"routes": [
		{ "pattern": "flickmadness.com", "custom_domain": true },
		{ "pattern": "www.flickmadness.com", "custom_domain": true },
		{ "pattern": "moviebout.com", "custom_domain": true },
		{ "pattern": "www.moviebout.com", "custom_domain": true },
	],
	// @sveltejs/adapter-cloudflare output: every route is prerendered except
	// /share/[code] (ADR 0003), which the worker renders at request time from
	// the baked /lists.json asset — no TMDB access at runtime. It's also the
	// hook for the draft-rooms backend — a Durable Object binding slots in
	// here when that lands.
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",
	},
}
